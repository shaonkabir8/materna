{
  "name": "materna",
  "version": "0.1.0",
  "private": false,
  "description": "Behavioral locale parity probing for Node.js and PostgreSQL",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cli": "./src/cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "materna": "./src/cli.js"
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shaonkabir8/materna"
  },
  "homepage": "https://github.com/shaonkabir8/materna",
  "bugs": {
    "url": "https://github.com/shaonkabir8/materna/issues"
  },
  "license": "MIT",
  "author": "Shaon Kabir",
  "keywords": [
    "collation",
    "locale",
    "i18n",
    "icu",
    "cldr",
    "postgresql",
    "postgres",
    "parity",
    "testing",
    "unicode"
  ],
  "scripts": {
    "test": "node --test",
    "probe:node": "node src/cli.js node",
    "probe:postgres": "node src/cli.js postgres",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
